<%- include('partials/header', { title: "Home — LinkVerse" }) %>

<h2 class="text-center mb-4">Latest Approved Novels, Movies, and Series</h2>

<div class="row">
  <% if (!links || links.length === 0) { %>
    <p class="text-center">No approved links yet. Check back soon!</p>
  <% } else { %>
    <% links.forEach(link => { %>
      <div class="col-md-3 mb-4">
        <div class="card h-100 shadow-sm">
          <img src="<%= link.thumbnail || '/images/default.jpg' %>" class="card-img-top" alt="Thumbnail">
          <div class="card-body">
            <h5 class="card-title">
              <a href="<%= link.link_url %>" target="_blank" class="text-decoration-none">
                <%= link.title %>
              </a>
            </h5>
            <p class="text-muted small text-uppercase"><%= link.category %></p>
            <p class="card-text"><%= link.description.slice(0, 80) %>...</p>
          </div>
          <div class="card-footer text-center">
            ⭐ <%= link.avg_rating ? link.avg_rating.toFixed(1) : 'No rating yet' %>
          </div>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>

<%- include('partials/footer') %>
