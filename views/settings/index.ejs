<%- include('../partials/header', { title: "Account Settings", session }) %>

<div class="container py-5 text-light">

  <h2 class="fw-bold mb-4">
    <i class="bi bi-gear text-danger me-2"></i> Account Settings
  </h2>

  <!-- ========================== -->
  <!-- COVER + PROFILE SECTION   -->
  <!-- ========================== -->

  <div class="position-relative mb-5">

    <div class="cover-photo rounded"
      onclick="openCoverModal()"
      style="
        width: 100%;
        height: 325px;
        background: url('/uploads/covers/<%= session.user.cover_pic || 'default-cover.jpg' %>') center/cover no-repeat;
        cursor: pointer;
        border-radius: 10px;
      ">
    </div>

    <button class="btn btn-dark btn-sm position-absolute"
      style="right: 20px; bottom: 10px;"
      onclick="openCoverModal()">
      <i class="bi bi-camera"></i> Edit Cover Photo
    </button>

    <div class="position-absolute"
      style="bottom: -45px; left: 40px; cursor: pointer;"
      onclick="openProfileModal()">

      <img src="/uploads/profile/<%= session.user.profile_pic || 'default-profile.png' %>"
        class="rounded-circle border border-3 border-dark"
        style="width: 200px; height: 200px; object-fit: cover;">
    </div>
  </div>

  <!-- ========================== -->
  <!-- ACCOUNT INFORMATION BOX   -->
  <!-- ========================== -->
  <div class="p-4 mb-4 rounded" style="background:#1e2329;">
    <h4 class="text-secondary mb-3">Account Information</h4>

    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <strong>Username:</strong> <%= session.user.username %>
      </div>
      <button class="btn btn-outline-light btn-sm" onclick="toggleUsernameEdit()">Edit</button>
    </div>

    <form id="username-edit-form" action="/account/update-username" method="POST" class="d-none">
      <div class="input-group mb-3">
        <input type="text" name="newUsername" class="form-control bg-dark text-light"
          value="<%= session.user.username %>" required>
        <button class="btn btn-success btn-sm">Save</button>
        <button type="button" onclick="toggleUsernameEdit()" class="btn btn-secondary btn-sm">Cancel</button>
      </div>
    </form>

    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <strong>Email:</strong> <%= session.user.email %>
      </div>
      <button class="btn btn-outline-light btn-sm" onclick="toggleEmailEdit()">Edit</button>
    </div>

    <form id="email-edit-form" action="/account/update-email" method="POST" class="d-none">
      <div class="input-group mb-3">
        <input type="email" name="newEmail" class="form-control bg-dark text-light"
          value="<%= session.user.email %>" required>
        <button class="btn btn-success btn-sm">Save</button>
        <button type="button" onclick="toggleEmailEdit()" class="btn btn-secondary btn-sm">Cancel</button>
      </div>
    </form>

    <p class="mt-3">
      <strong>Member Since:</strong>
      <%= new Date(session.user.created_at).toLocaleString() %>
    </p>

    <p>
      <strong>Total Watch Time:</strong> <%= totalWatchTime || 0 %> hours
    </p>
  </div>

  <!-- ========================== -->
  <!-- PASSWORD BOX -->
  <!-- ========================== -->
  <div class="p-4 rounded" style="background:#1e2329;">
    <h4 class="text-secondary mb-3">Security</h4>

    <button class="btn btn-outline-danger w-100" onclick="openPasswordModal()">
      <i class="bi bi-key me-2"></i> Change Password
    </button>
  </div>

</div>

<!-- ============================= -->
<!-- PROFILE PICTURE MODAL        -->
<!-- ============================= -->
<div class="modal fade" id="profileModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content bg-dark text-light p-3">
      <h5 class="fw-bold mb-3">Upload New Profile Picture</h5>

      <form action="/account/update-profile-picture" method="POST" enctype="multipart/form-data">
        <input type="file" name="profile_pic" class="form-control bg-black text-light mb-3" accept="image/*" required>
        <button class="btn btn-danger w-100">Upload</button>
      </form>
    </div>
  </div>
</div>

<!-- ============================= -->
<!-- COVER PHOTO MODAL            -->
<!-- ============================= -->
<div class="modal fade" id="coverModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content bg-dark text-light p-3">
      <h5 class="fw-bold mb-3">Upload New Cover Photo</h5>

      <form action="/account/update-cover-photo" method="POST" enctype="multipart/form-data">
        <input type="file" name="cover_pic" class="form-control bg-black text-light mb-3" accept="image/*" required>
        <button class="btn btn-danger w-100">Upload</button>
      </form>
    </div>
  </div>
</div>

<!-- ============================= -->
<!-- PASSWORD MODAL               -->
<!-- ============================= -->
<div class="modal fade" id="passwordModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content bg-dark text-light p-3">

      <h5 class="fw-bold mb-3">Change Password</h5>

      <!-- ERROR/SUCCESS MESSAGES -->
      <% if (passwordError) { %>
        <p class="text-danger"><%= passwordError %></p>
      <% } %>

      <% if (passwordSuccess) { %>
        <p class="text-success">Password updated successfully!</p>
      <% } %>

      <form action="/account/update-password" method="POST">

        <input type="password" name="oldPassword"
          class="form-control bg-black text-light mb-2"
          placeholder="Old password" required>

        <input type="password" name="newPassword"
          class="form-control bg-black text-light mb-2"
          placeholder="New password" required>

        <input type="password" name="confirmPassword"
          class="form-control bg-black text-light mb-3"
          placeholder="Confirm password" required>

        <button class="btn btn-danger w-100">Update Password</button>
      </form>
    </div>
  </div>
</div>

<script>
  function toggleUsernameEdit() {
    document.getElementById("username-edit-form").classList.toggle("d-none");
  }

  function toggleEmailEdit() {
    document.getElementById("email-edit-form").classList.toggle("d-none");
  }

  function openProfileModal() {
    new bootstrap.Modal(document.getElementById('profileModal')).show();
  }

  function openCoverModal() {
    new bootstrap.Modal(document.getElementById('coverModal')).show();
  }

  function openPasswordModal() {
    new bootstrap.Modal(document.getElementById('passwordModal')).show();
  }

  // AUTO OPEN PASSWORD MODAL IF ERROR OR SUCCESS EXISTS
  <% if (passwordError || passwordSuccess) { %>
    window.onload = function () {
      new bootstrap.Modal(document.getElementById('passwordModal')).show();
    };
  <% } %>
</script>


<%- include('../partials/footer') %>
