<%- include('../partials/header', { title: "Add Episode", session: session }) %>

<section class="container py-5 text-light">
  <h2 class="fw-bold mb-4"><i class="bi bi-collection-play text-danger me-2"></i> Add Episode</h2>

  <form 
    action="/admin/<%= video.id %>/add-episode"
    method="POST"
    enctype="multipart/form-data"
    class="bg-black p-4 rounded shadow-sm"
  >
    <div class="mb-3">
      <label class="form-label text-secondary">Episode Title</label>
      <input 
        type="text" 
        name="episode_title" 
        class="form-control bg-dark text-light border-secondary" 
        placeholder="Enter episode title"
        required
      >
    </div>

    <div class="mb-3">
      <label class="form-label text-secondary">Episode Number</label>
      <input 
        type="number" 
        name="episode_number" 
        class="form-control bg-dark text-light border-secondary" 
        min="1"
        required
      >
    </div>

    <div class="row mb-3">
      <div class="col-md-6">
        <label class="form-label text-secondary">Episode Thumbnail</label>
        <input 
          type="file" 
          name="episode_thumbnail" 
          accept="image/*" 
          class="form-control bg-dark text-light border-secondary"
          required
        >
      </div>
      <div class="col-md-6">
        <label class="form-label text-secondary">Episode Video (MP4, MOV, MKV)</label>
        <input 
          type="file" 
          name="episode_file" 
          accept="video/*" 
          class="form-control bg-dark text-light border-secondary"
          required
        >
      </div>
    </div>

    <div class="text-end mt-4">
      <button class="btn btn-danger px-5 fw-semibold">
        <i class="bi bi-upload me-1"></i> Add Episode
      </button>
    </div>
  </form>
</section>

<%- include('../partials/footer') %>
