<%- include('../partials/header', { title, session: session }) %>

<div class="container py-5 text-light">
  <h2 class="fw-bold mb-4">
    <i class="bi bi-collection-play text-danger me-2"></i> Add Episode to <%= video.title %>
  </h2>

  <form
    action="/admin/<%= video.id %>/add-episode"
    method="POST"
    enctype="multipart/form-data"
    class="bg-black p-4 rounded-4 shadow-sm"
  >
    <div class="mb-3">
      <label class="form-label text-secondary">Episode Title</label>
      <input
        type="text"
        name="episode_title"
        class="form-control bg-dark text-light border-secondary"
        placeholder="Episode title (optional)"
      />
    </div>

    <div class="mb-3">
      <label class="form-label text-secondary">Upload Video File</label>
      <input
        type="file"
        name="episode_file"
        accept="video/*"
        class="form-control bg-dark text-light border-secondary"
        required
      />
    </div>

    <div class="text-end">
      <button class="btn btn-danger px-5 py-2 fw-semibold">
        <i class="bi bi-upload me-1"></i> Upload Episode
      </button>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
