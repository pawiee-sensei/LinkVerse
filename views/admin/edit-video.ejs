<div class="container py-5 text-light">
  <section class="admin-edit">
    <h2 class="fw-bold mb-4">
      <i class="bi bi-pencil-square text-danger me-2"></i> Edit Video
    </h2>

    <form
      action="/admin/edit/<%= video.id %>"
      method="POST"
      enctype="multipart/form-data"
      class="bg-black p-4 rounded-4 shadow-sm"
    >
      <div class="mb-3">
        <label class="form-label text-secondary">Title</label>
        <input type="text" name="title" value="<%= video.title %>" class="form-control bg-dark text-light border-secondary" required />
      </div>

      <div class="mb-3">
        <label class="form-label text-secondary">Synopsis</label>
        <textarea name="synopsis" rows="4" class="form-control bg-dark text-light border-secondary" required><%= video.synopsis %></textarea>
      </div>

      <div class="mb-3">
        <label class="form-label text-secondary">Category</label>
        <select name="category" class="form-select bg-dark text-light border-secondary">
          <option value="Drama" <%= video.category === 'Drama' ? 'selected' : '' %>>Drama</option>
          <option value="Anime" <%= video.category === 'Anime' ? 'selected' : '' %>>Anime</option>
          <option value="Movie" <%= video.category === 'Movie' ? 'selected' : '' %>>Movie</option>
          <option value="Documentary" <%= video.category === 'Documentary' ? 'selected' : '' %>>Documentary</option>
        </select>
      </div>

      <!-- 🎯 FIXED: GENRE INSIDE THE FORM -->
      <div class="mb-3">
        <label class="form-label text-secondary">Genre</label>
        <select name="genre" class="form-select bg-dark text-light border-secondary" required>
          <option value="Action" <%= video.genre === 'Action' ? 'selected' : '' %>>Action</option>
          <option value="Adventure" <%= video.genre === 'Adventure' ? 'selected' : '' %>>Adventure</option>
          <option value="Comedy" <%= video.genre === 'Comedy' ? 'selected' : '' %>>Comedy</option>
          <option value="Drama" <%= video.genre === 'Drama' ? 'selected' : '' %>>Drama</option>
          <option value="Fantasy" <%= video.genre === 'Fantasy' ? 'selected' : '' %>>Fantasy</option>
          <option value="Horror" <%= video.genre === 'Horror' ? 'selected' : '' %>>Horror</option>
          <option value="Romance" <%= video.genre === 'Romance' ? 'selected' : '' %>>Romance</option>
          <option value="Sci-Fi" <%= video.genre === 'Sci-Fi' ? 'selected' : '' %>>Sci-Fi</option>
          <option value="Thriller" <%= video.genre === 'Thriller' ? 'selected' : '' %>>Thriller</option>
          <option value="Slice of Life" <%= video.genre === 'Slice of Life' ? 'selected' : '' %>>Slice of Life</option>
          <option value="Supernatural" <%= video.genre === 'Supernatural' ? 'selected' : '' %>>Supernatural</option>
          <option value="Sports" <%= video.genre === 'Sports' ? 'selected' : '' %>>Sports</option>
        </select>
      </div>

      <div class="mb-3">
        <label class="form-label text-secondary">Update Banner (optional)</label>
        <input type="file" name="banner" accept="image/*" class="form-control bg-dark text-light border-secondary" />
        <% if (video.banner) { %>
          <small class="text-secondary d-block mt-2">Current banner:</small>
          <img src="/uploads/banners/<%= video.banner %>" class="mt-1 rounded" style="width:200px;height:110px;object-fit:cover;">
        <% } %>
      </div>

      <div class="text-end mt-4">
        <button class="btn btn-danger px-5 py-2 fw-semibold">
          <i class="bi bi-save me-1"></i> Save Changes
        </button>
      </div>
    </form>
  </section>

  <hr class="text-secondary my-5">

  <!-- EPISODES SECTION (UNCHANGED) -->
  <section class="episodes mt-5">
    ... (your episode cards here)
  </section>
</div>
