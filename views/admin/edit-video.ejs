<div class="container py-5 text-light">

  <!-- ========================= -->
  <!-- MAIN VIDEO EDIT SECTION   -->
  <!-- ========================= -->
  <section class="admin-edit">
    <h2 class="fw-bold mb-4">
      <i class="bi bi-pencil-square text-danger me-2"></i> Edit Video
    </h2>

    <form
      action="/admin/edit/<%= video.id %>"
      method="POST"
      enctype="multipart/form-data"
      class="bg-black p-4 rounded-4 shadow-sm"
    >
      <div class="mb-3">
        <label class="form-label text-secondary">Title</label>
        <input
          type="text"
          name="title"
          value="<%= video.title %>"
          class="form-control bg-dark text-light border-secondary"
          required
        />
      </div>

      <div class="mb-3">
        <label class="form-label text-secondary">Synopsis</label>
        <textarea
          name="synopsis"
          rows="4"
          class="form-control bg-dark text-light border-secondary"
          required
        ><%= video.synopsis %></textarea>
      </div>

      <div class="mb-3">
        <label class="form-label text-secondary">Category</label>
        <select name="category" class="form-select bg-dark text-light border-secondary">
          <option value="Drama" <%= video.category === 'Drama' ? 'selected' : '' %>>Drama</option>
          <option value="Anime" <%= video.category === 'Anime' ? 'selected' : '' %>>Anime</option>
          <option value="Movie" <%= video.category === 'Movie' ? 'selected' : '' %>>Movie</option>
          <option value="Documentary" <%= video.category === 'Documentary' ? 'selected' : '' %>>Documentary</option>
        </select>
      </div>

      <!-- 🎯 GENRE DROPDOWN FIXED & INSIDE FORM -->
      <div class="mb-3">
        <label class="form-label text-secondary">Genre</label>
        <select name="genre" class="form-select bg-dark text-light border-secondary" required>
          <option value="Action" <%= video.genre === 'Action' ? 'selected' : '' %>>Action</option>
          <option value="Adventure" <%= video.genre === 'Adventure' ? 'selected' : '' %>>Adventure</option>
          <option value="Comedy" <%= video.genre === 'Comedy' ? 'selected' : '' %>>Comedy</option>
          <option value="Drama" <%= video.genre === 'Drama' ? 'selected' : '' %>>Drama</option>
          <option value="Fantasy" <%= video.genre === 'Fantasy' ? 'selected' : '' %>>Fantasy</option>
          <option value="Horror" <%= video.genre === 'Horror' ? 'selected' : '' %>>Horror</option>
          <option value="Romance" <%= video.genre === 'Romance' ? 'selected' : '' %>>Romance</option>
          <option value="Sci-Fi" <%= video.genre === 'Sci-Fi' ? 'selected' : '' %>>Sci-Fi</option>
          <option value="Thriller" <%= video.genre === 'Thriller' ? 'selected' : '' %>>Thriller</option>
          <option value="Slice of Life" <%= video.genre === 'Slice of Life' ? 'selected' : '' %>>Slice of Life</option>
          <option value="Supernatural" <%= video.genre === 'Supernatural' ? 'selected' : '' %>>Supernatural</option>
          <option value="Sports" <%= video.genre === 'Sports' ? 'selected' : '' %>>Sports</option>
        </select>
      </div>

      <div class="mb-3">
        <label class="form-label text-secondary">Update Banner (optional)</label>
        <input
          type="file"
          name="banner"
          accept="image/*"
          class="form-control bg-dark text-light border-secondary"
        />
        <% if (video.banner) { %>
          <small class="text-secondary d-block mt-2">Current banner:</small>
          <img
            src="/uploads/banners/<%= video.banner %>"
            class="mt-1 rounded"
            style="width:200px;height:110px;object-fit:cover;"
          />
        <% } %>
      </div>

      <div class="mb-3">
  <label class="form-label text-secondary">Update Thumbnail (optional)</label>
  <input
    type="file"
    name="thumbnail"
    accept="image/*"
    class="form-control bg-dark text-light border-secondary"
  />

  <% if (video.thumbnail) { %>
    <small class="text-secondary d-block mt-2">Current thumbnail:</small>
    <img
      src="/uploads/thumbnails/<%= video.thumbnail %>"
      class="mt-1 rounded"
      style="width:200px;height:110px;object-fit:cover;"
    />
  <% } %>
</div>


      

        

      <div class="text-end mt-4">
        <button class="btn btn-danger px-5 py-2 fw-semibold">
          <i class="bi bi-save me-1"></i> Save Changes
        </button>
      </div>

    </form>
  </section>

  <hr class="text-secondary my-5">

  <!-- ========================= -->
  <!-- EPISODES SECTION (WORKING) -->
  <!-- ========================= -->
  <section class="episodes mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h4 class="fw-bold mb-0">
        <i class="bi bi-collection-play text-danger me-2"></i> Episodes
      </h4>

      <!-- ADD EPISODE BUTTON (BACK) -->
      <a href="/admin/<%= video.id %>/add-episode" class="btn btn-outline-danger btn-sm fw-semibold">
        <i class="bi bi-plus-circle me-1"></i> Add Episode
      </a>
    </div>

    <% if (episodes.length === 0) { %>

      <p class="text-secondary">No episodes yet. Click “Add Episode” to upload one.</p>

    <% } else { %>

      <div class="row g-4">

        <% episodes.forEach(ep => { %>

          <div class="col-md-4 col-lg-3">

            <div class="card bg-dark border-0 shadow-sm hover-card rounded-3 overflow-hidden">

              <!-- THUMBNAIL CLICKABLE PREVIEW -->
              <div 
                class="position-relative ratio ratio-16x9 episode-thumbnail"
                data-bs-toggle="modal"
                data-bs-target="#previewModal"
                data-title="<%= ep.episode_title %>"
                data-video="/uploads/videos/<%= ep.episode_file %>"
              >
                <img 
                  src="/uploads/episode_thumbnails/<%= ep.episode_thumbnail %>"
                  class="w-100 h-100"
                  style="object-fit: cover; cursor: pointer;"
                  onerror="this.src='/images/default-banner.jpg';"
                >
                <div class="position-absolute top-50 start-50 translate-middle">
                  <i class="bi bi-play-circle-fill fs-2 text-light opacity-75"></i>
                </div>
              </div>

              <!-- INFO -->
              <div class="card-body px-2 py-3">
                <h6 class="fw-semibold text-light mb-1 text-truncate"><%= ep.episode_title %></h6>
                <p class="text-secondary small mb-3">Episode <%= ep.episode_number %></p>

                <div class="d-flex justify-content-between align-items-center">

                  <!-- EDIT EPISODE -->
                  <a href="/admin/edit-episode/<%= ep.id %>" class="btn btn-sm btn-outline-light px-3">
                    <i class="bi bi-pencil-square"></i>
                  </a>

                  <!-- DELETE EPISODE -->
                  <form 
                    action="/admin/delete-episode/<%= ep.id %>" 
                    method="POST" 
                    onsubmit="return confirm('Delete this episode?')"
                    class="d-inline"
                  >
                    <button class="btn btn-sm btn-outline-danger px-3">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>

                </div>
              </div>

            </div>
          </div>

        <% }) %>

      </div>

    <% } %>

  </section>


  <!-- ========================= -->
  <!-- VIDEO PREVIEW MODAL      -->
  <!-- ========================= -->
  <div class="modal fade" id="previewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content bg-dark text-light border-secondary">
        <div class="modal-header border-secondary">
          <h5 class="modal-title fw-semibold" id="previewTitle">Preview</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="ratio ratio-16x9">
            <video id="previewVideo" class="w-100 rounded" controls preload="metadata">
              <source src="" type="video/mp4">
            </video>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const modal = document.getElementById("previewModal");
  const title = document.getElementById("previewTitle");
  const video = document.getElementById("previewVideo");

  modal.addEventListener("show.bs.modal", (event) => {
    const trigger = event.relatedTarget;
    title.textContent = trigger.getAttribute("data-title");
    video.querySelector("source").src = trigger.getAttribute("data-video");
    video.load();
  });

  modal.addEventListener("hidden.bs.modal", () => {
    video.pause();
  });
});
</script>
