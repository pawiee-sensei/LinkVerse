<section class="admin-upload">
  <h2 class="fw-bold mb-4"><i class="bi bi-cloud-upload text-danger me-2"></i> Upload New Content</h2>

  <form action="/admin/uploads" method="POST" enctype="multipart/form-data" class="upload-form bg-black p-4 rounded-4 shadow-sm">
    <div class="mb-3">
      <label class="form-label text-secondary">Title</label>
      <input type="text" name="title" class="form-control" placeholder="Enter drama/movie/anime title" required />
    </div>

    <div class="mb-3">
      <label class="form-label text-secondary">Synopsis</label>
      <textarea name="synopsis" class="form-control" rows="4" placeholder="Short description or summary..." required></textarea>
    </div>

    <div class="mb-3">
      <label class="form-label text-secondary">Category</label>
      <select name="category" class="form-select" required>
        <option value="Drama">Drama</option>
        <option value="Anime">Anime</option>
        <option value="Movie">Movie</option>
        <option value="Documentary">Documentary</option>
      </select>
    </div>

    <div class="row mb-3">
      <div class="col-md-6">
        <label class="form-label text-secondary">Banner Image</label>
        <input type="file" name="banner" accept="image/*" class="form-control" required />
      </div>
      <div class="col-md-6">
        <label class="form-label text-secondary">Video File (MP4, MOV, MKV)</label>
        <input type="file" name="videoFile" accept="video/*" class="form-control" required />
      </div>
    </div>

    <div class="text-end">
      <button class="btn btn-danger px-5 py-2 fw-semibold">
        <i class="bi bi-upload me-1"></i> Upload
      </button>
    </div>
  </form>
</section>
