

<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="text-light fw-bold">🎞 Manage Uploads</h3>
    <a href="/admin/upload" class="btn btn-danger">
      <i class="bi bi-cloud-upload"></i> New Upload
    </a>
  </div>

  <!-- Search + Sort -->
  <form class="d-flex mb-4" method="GET" action="/admin/uploads">
    <input type="text" name="search" class="form-control me-2" placeholder="Search title..." value="<%= search %>">
    <select name="sort" class="form-select me-2">
      <option value="created_at" <%= sort === 'created_at' ? 'selected' : '' %>>Newest</option>
      <option value="views" <%= sort === 'views' ? 'selected' : '' %>>Most Viewed</option>
      <option value="title" <%= sort === 'title' ? 'selected' : '' %>>Title</option>
    </select>
    <button class="btn btn-outline-light" type="submit">Search</button>
  </form>

  <!-- Video Grid -->
  <div class="row g-4">
    <% if (videos.length === 0) { %>
      <p class="text-center text-secondary">No videos found.</p>
    <% } else { %>
      <% videos.forEach(video => { %>
        <div class="col-md-3">
          <div class="card bg-dark text-light border-0 shadow-sm h-100 position-relative">
            <img src="/uploads/banners/<%= video.banner %>" class="card-img-top" alt="<%= video.title %>" onerror="this.src='/images/default-banner.jpg';">
            <div class="card-body">
              <h6 class="card-title"><%= video.title %></h6>
              <p class="small text-muted mb-1"><%= video.category %></p>
              <p class="small text-secondary mb-1">👁 <%= video.views %> views</p>
              <p class="small text-secondary">🕒 <%= new Date(video.created_at).toLocaleString() %></p>
            </div>
            <div class="card-footer bg-transparent border-top border-secondary d-flex justify-content-between">
              <a href="/admin/edit/<%= video.id %>" class="btn btn-sm btn-outline-light"><i class="bi bi-pencil-square"></i></a>
              <a href="/admin/delete/<%= video.id %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this video?')"><i class="bi bi-trash"></i></a>
            </div>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>


