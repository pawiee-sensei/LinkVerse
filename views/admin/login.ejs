<%- include('../partials/header', { title: "Admin Login", session: session }) %>

<div class="admin-login-container">
  <div class="admin-login-card">
    <div class="admin-login-header text-center">
      <i class="bi bi-shield-lock-fill text-danger fs-1 mb-2"></i>
      <h3 class="fw-bold mb-0">Admin Portal</h3>
      <p class="text-secondary small">Access restricted to authorized administrators only.</p>
    </div>

    <% if (message) { %>
      <div class="alert alert-danger py-2 px-3 mt-3"><%= message %></div>
    <% } %>

    <form method="POST" action="/admin/login" class="mt-3">
      <div class="form-group mb-3">
        <label class="form-label text-secondary small">Admin Email</label>
        <input type="email" name="email" class="form-control admin-input" placeholder="Enter admin email" required />
      </div>

      <div class="form-group mb-4">
        <label class="form-label text-secondary small">Password</label>
        <input type="password" name="password" class="form-control admin-input" placeholder="Enter password" required />
      </div>

      <button class="btn btn-danger w-100 py-2 fw-semibold">Login</button>
    </form>

    <div class="text-center mt-4 small text-secondary">
      <i class="bi bi-exclamation-circle me-1 text-danger"></i>
      This section is for administrators only.
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
