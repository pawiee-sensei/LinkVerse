<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : "LinkVerse" %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>

<%
  const safePageClass = typeof pageClass !== 'undefined' ? pageClass : '';
  const safeHideNav = typeof hideNav !== 'undefined' ? hideNav : false;
%>

<body class="<%= safePageClass %>">
  <% if (!safeHideNav) { %>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/">LinkVerse</a>
      <div class="collapse navbar-collapse">
        <ul class="navbar-nav ms-auto">
          <% if (currentUser) { %>
            <li class="nav-item"><a class="nav-link" href="/upload">Upload</a></li>
            <% if (currentUser.role === 'admin') { %>
              <li class="nav-item"><a class="nav-link" href="/admin/dashboard">Admin</a></li>
            <% } %>
            <li class="nav-item"><a class="nav-link" href="/logout">Logout</a></li>
          <% } else { %>
            <li class="nav-item"><a class="nav-link" href="/login">Login</a></li>
            <li class="nav-item"><a class="nav-link" href="/register">Register</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>
  <% } %>

  <main class="container my-5">
